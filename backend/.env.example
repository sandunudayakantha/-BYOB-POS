COMPOSE_PROJECT_NAME=byob-pos
APP_ENV=development
APP_DEBUG=true
ALLOWED_ORIGINS_STR=http://localhost:3000,http://localhost:8000,http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=byob_pos
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET_KEY=change-me-use-python-secrets-token-urlsafe-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

OVH_S3_ENDPOINT_URL=
OVH_S3_BASE_URL=
OVH_S3_ACCESS_KEY=
OVH_S3_SECRET_KEY=
OVH_S3_BUCKET_NAME=
OVH_S3_REGION=gra
OVH_S3_KEY_PREFIX=

RBAC_SEED_ON_STARTUP=true
LOOKUPS_SEED_ON_STARTUP=true

INVOICE_AUDIT_LOG_PATH=logs/invoice-audit.jsonl
INVOICE_AUDIT_MAX_BYTES=10485760
INVOICE_AUDIT_BACKUPS=30
INVOICE_AUDIT_POLL_SECONDS=5.0

WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_URL=
